  "version": "2.4.0",
  "description": "Extendable file viewer for web",
  "author": "javier-mora",
  "license": "MIT",
  "funding": "https://github.com/sponsors/javier-mora",
  "type": "module",
  "homepage": "https://javier-mora.github.io/react-file-viewer-v2/",
  "repository": {
    "type": "git",
    "url": "https://github.com/javier-mora/react-file-viewer-v2.git"
  },
  "main": "dist/main.js",
