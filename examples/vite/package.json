{
  "name": "react-file-viewer-v2-storybook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "storybook": "npm --prefix ../.. run build && storybook dev -p 6006",
    "build-storybook": "npm --prefix ../.. run build && storybook build --output-dir storybook-static",
    "storybook:serve": "http-server storybook-static -p 4310 -c-1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.3.0",
    "@storybook/addon-docs": "10.3.0",
    "@storybook/web-components-vite": "10.3.0",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "6.0.1",
    "http-server": "^14.1.1",
    "lit": "^3.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "10.3.0",
    "typescript": "^5.9.3",
    "vite": "8.0.1"
  }
}
